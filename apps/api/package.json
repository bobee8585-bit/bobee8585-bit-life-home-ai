{
  "name": "@lifehome/api",
  "version": "0.26.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run prisma:generate",
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:media-worker": "tsx watch src/media-worker.ts",
    "start": "node dist/main.js",
    "start:media-worker": "node dist/media-worker.js",
    "pretest": "npm run prisma:generate",
    "test": "vitest run src",
    "pretypecheck": "npm run prisma:generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:typecheck": "tsc -p tsconfig.prisma.json",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1095.0",
    "@lifehome/contracts": "*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.1.28",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "bullmq": "5.81.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "^0.34.5",
    "uuid": "13.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@types/express": "5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "24.10.13",
    "@types/pg": "8.20.0",
    "prisma": "7.9.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
