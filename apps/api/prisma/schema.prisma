generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  RESTRICTED
  DORMANT
  WITHDRAWN
  BANNED
}

enum MenuState {
  ACTIVE
  HIDDEN
  READ_ONLY
  INTAKE_DISABLED
  DISABLED
  MAINTENANCE
}

enum Platform {
  ANDROID
  IOS
  USER_WEB
  BROKER_WEB
  ADMIN_CMS
  API
}

enum ServiceModuleCode {
  REAL_ESTATE
  LIFE_CONVENIENCE
  ROOMMATE
  SENIOR
  FUNERAL
  CHILDCARE
  PET
  MOVING
  COMMUNITY
}

enum VerificationChannel {
  EMAIL
  SMS
}

enum VerificationPurpose {
  EMAIL_VERIFY
  PHONE_VERIFY
  PASSWORD_RESET
}

enum BrokerageStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
  CLOSED
}

enum BrokerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  INACTIVE
  ARCHIVED
}

enum PropertyType {
  APARTMENT
  VILLA
  OFFICETEL
  DETACHED_HOUSE
  MULTIFAMILY_HOUSE
  COMMERCIAL
  LAND
}

enum PropertyTransactionType {
  SALE
  JEONSE
  MONTHLY_RENT
}

enum PropertyListingType {
  BROKERAGE
  OWNER_DIRECT
}

enum OwnershipClaimType {
  REGISTERED_OWNER
  AUTHORIZED_REPRESENTATIVE
}

enum OwnershipVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PropertyMediaType {
  IMAGE
  VIDEO
}

enum MediaUploadStatus {
  REQUESTED
  PROCESSING
  READY
  FAILED
}

enum PropertyReportReason {
  FALSE_INFORMATION
  DUPLICATE
  UNAVAILABLE
  FRAUD_SUSPECTED
  ILLEGAL_CONTENT
  OTHER
}

enum PropertyReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum VisitReservationStatus {
  REQUESTED
  ALTERNATIVE_PROPOSED
  CONFIRMED
  REJECTED
  ALTERNATIVE_DECLINED
  CANCELLED
  COMPLETED
}

enum VisitReservationAction {
  REQUESTED
  APPROVED
  REJECTED
  ALTERNATIVE_PROPOSED
  ALTERNATIVE_ACCEPTED
  ALTERNATIVE_DECLINED
  CANCELLED
  COMPLETED
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  SKIPPED
  FAILED
}

enum NotificationChannel {
  PUSH
  SMS
}

enum NotificationEndpointStatus {
  ACTIVE
  INVALID
  REVOKED
}

enum ChatMessageType {
  TEXT
  SYSTEM
}

enum ElectronicContractProvider {
  MODOOSIGN
  EFORM_SIGN
  GOVERNMENT
}

enum ElectronicContractStatus {
  DRAFT
  SIGNING_PENDING
  PARTIALLY_SIGNED
  SIGNED
  DECLINED
  CANCELLED
  EXPIRED
  FAILED
}

enum ElectronicContractPartyRole {
  MEMBER
  REGISTRANT
}

enum ElectronicContractPartyStatus {
  PENDING
  VIEWED
  SIGNED
  DECLINED
}

enum ContractWebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum ReservationDepositStatus {
  READY
  PAID
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  CANCELLED
}

enum PaymentTransactionType {
  PREPARE
  CAPTURE
  REFUND
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ReservationRefundReason {
  USER_CANCELLATION
  BROKER_CANCELLATION
  PROPERTY_UNAVAILABLE
  ADMIN_OVERRIDE
}

enum PaymentWebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

model User {
  id                      String                          @id @db.Uuid
  memberNumber            String                          @unique @map("member_number")
  email                   String?                         @unique
  phoneCountryCode        String?                         @map("phone_country_code")
  phoneNumberEncrypted    String?                         @map("phone_number_encrypted")
  phoneHash               String?                         @unique @map("phone_hash")
  passwordHash            String?                         @map("password_hash")
  status                  UserStatus                      @default(PENDING)
  emailVerifiedAt         DateTime?                       @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt         DateTime?                       @map("phone_verified_at") @db.Timestamptz(6)
  lastLoginAt             DateTime?                       @map("last_login_at") @db.Timestamptz(6)
  failedLoginCount        Int                             @default(0) @map("failed_login_count")
  lockedUntil             DateTime?                       @map("locked_until") @db.Timestamptz(6)
  deletedAt               DateTime?                       @map("deleted_at") @db.Timestamptz(6)
  createdAt               DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(6)
  profile                 UserProfile?
  roles                   UserRole[]
  sessions                UserSession[]
  verificationChallenges  VerificationChallenge[]
  brokerProfile           BrokerProfile?
  properties              Property[]                      @relation("PropertyRegistrant")
  reviewedProperties      Property[]                      @relation("PropertyReviewer")
  ownershipClaims         PropertyOwnershipVerification[] @relation("OwnershipClaimant")
  reviewedOwnershipClaims PropertyOwnershipVerification[] @relation("OwnershipReviewer")
  mediaUploads            PropertyMediaUpload[]
  propertyReports         PropertyReport[]                @relation("PropertyReporter")
  assignedReports         PropertyReport[]                @relation("PropertyReportAssignee")
  reportHistories         PropertyReportHistory[]         @relation("PropertyReportHistoryActor")
  requestedVisits         VisitReservation[]              @relation("VisitReservationRequester")
  managedVisits           VisitReservation[]              @relation("VisitReservationBroker")
  visitHistories          VisitReservationHistory[]
  notificationOutbox      NotificationOutbox[]
  notificationEndpoints   NotificationEndpoint[]
  reservationDeposits     ReservationDeposit[]
  memberChatRooms         PropertyChatRoom[]              @relation("PropertyChatMember")
  registrantChatRooms     PropertyChatRoom[]              @relation("PropertyChatRegistrant")
  sentChatMessages        ChatMessage[]                   @relation("ChatMessageSender")
  createdContracts        ElectronicContract[]            @relation("ElectronicContractCreator")
  memberContracts         ElectronicContract[]            @relation("ElectronicContractMember")
  registrantContracts     ElectronicContract[]            @relation("ElectronicContractRegistrant")
  contractParties         ElectronicContractParty[]

  @@map("users")
}

model VerificationChallenge {
  id                   String              @id @db.Uuid
  userId               String?             @map("user_id") @db.Uuid
  channel              VerificationChannel
  purpose              VerificationPurpose
  destinationHash      String              @map("destination_hash")
  destinationEncrypted String              @map("destination_encrypted")
  secretHash           String              @map("secret_hash")
  attempts             Int                 @default(0)
  expiresAt            DateTime            @map("expires_at") @db.Timestamptz(6)
  consumedAt           DateTime?           @map("consumed_at") @db.Timestamptz(6)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  user                 User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, consumedAt, expiresAt])
  @@index([destinationHash, purpose, createdAt])
  @@map("verification_challenges")
}

model UserSession {
  id            String                @id @db.Uuid
  userId        String                @map("user_id") @db.Uuid
  platform      Platform?
  ipAddress     String?               @map("ip_address")
  userAgent     String?               @map("user_agent")
  expiresAt     DateTime              @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime?             @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt    DateTime              @default(now()) @map("last_used_at") @db.Timestamptz(6)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens SessionRefreshToken[]

  @@index([userId, revokedAt, expiresAt])
  @@map("user_sessions")
}

model SessionRefreshToken {
  id        String      @id @db.Uuid
  sessionId String      @map("session_id") @db.Uuid
  tokenHash String      @unique @map("token_hash")
  expiresAt DateTime    @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?   @map("used_at") @db.Timestamptz(6)
  revokedAt DateTime?   @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  session   UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, usedAt, revokedAt, expiresAt])
  @@map("session_refresh_tokens")
}

model UserProfile {
  userId            String   @id @map("user_id") @db.Uuid
  displayName       String   @map("display_name")
  realNameEncrypted String?  @map("real_name_encrypted")
  preferredLanguage String   @default("ko-KR") @map("preferred_language")
  timezone          String   @default("Asia/Seoul")
  countryCode       String   @default("KR") @map("country_code")
  regionId          String?  @map("region_id") @db.Uuid
  marketingConsent  Boolean  @default(false) @map("marketing_consent")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Role {
  id           String           @id @db.Uuid
  code         String           @unique
  name         String
  description  String?
  isSystem     Boolean          @default(false) @map("is_system")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  users        UserRole[]
  permissions  RolePermission[]
  menuPolicies MenuPolicy[]

  @@map("roles")
}

model Permission {
  id          String           @id @db.Uuid
  code        String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  startsAt  DateTime  @default(now()) @map("starts_at") @db.Timestamptz(6)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  grantedBy String?   @map("granted_by") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model ServiceModule {
  id           String            @id @db.Uuid
  code         ServiceModuleCode @unique
  name         String
  defaultState MenuState         @default(HIDDEN) @map("default_state")
  sortOrder    Int               @default(0) @map("sort_order")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  menus        Menu[]

  @@map("service_modules")
}

model Menu {
  id              String             @id @db.Uuid
  serviceModuleId String             @map("service_module_id") @db.Uuid
  parentMenuId    String?            @map("parent_menu_id") @db.Uuid
  code            String             @unique
  name            String
  platform        Platform
  route           String?
  apiScope        String?            @map("api_scope")
  defaultState    MenuState          @default(HIDDEN) @map("default_state")
  sortOrder       Int                @default(0) @map("sort_order")
  isSystemMenu    Boolean            @default(false) @map("is_system_menu")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  serviceModule   ServiceModule      @relation(fields: [serviceModuleId], references: [id], onDelete: Restrict)
  parent          Menu?              @relation("MenuTree", fields: [parentMenuId], references: [id], onDelete: Restrict)
  children        Menu[]             @relation("MenuTree")
  policies        MenuPolicy[]
  stateHistories  MenuStateHistory[]

  @@index([serviceModuleId, platform, sortOrder])
  @@map("menus")
}

model MenuPolicy {
  id          String    @id @db.Uuid
  menuId      String    @map("menu_id") @db.Uuid
  roleId      String?   @map("role_id") @db.Uuid
  state       MenuState
  platform    Platform?
  countryCode String?   @map("country_code")
  regionId    String?   @map("region_id") @db.Uuid
  message     String?
  reason      String
  priority    Int       @default(0)
  isEmergency Boolean   @default(false) @map("is_emergency")
  startsAt    DateTime  @default(now()) @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime? @map("ends_at") @db.Timestamptz(6)
  createdBy   String    @map("created_by") @db.Uuid
  approvedBy  String?   @map("approved_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  menu        Menu      @relation(fields: [menuId], references: [id], onDelete: Cascade)
  role        Role?     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([menuId, startsAt, endsAt])
  @@index([countryCode, regionId, platform, priority])
  @@map("menu_policies")
}

model MenuStateHistory {
  id            String    @id @db.Uuid
  menuId        String    @map("menu_id") @db.Uuid
  previousState MenuState @map("previous_state")
  nextState     MenuState @map("next_state")
  changedBy     String    @map("changed_by") @db.Uuid
  approvedBy    String?   @map("approved_by") @db.Uuid
  reason        String
  changedAt     DateTime  @default(now()) @map("changed_at") @db.Timestamptz(6)
  menu          Menu      @relation(fields: [menuId], references: [id], onDelete: Restrict)

  @@index([menuId, changedAt])
  @@map("menu_state_histories")
}

model AuditLog {
  id         String   @id @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String?  @map("actor_role")
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  reason     String?
  requestId  String?  @map("request_id")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  succeeded  Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("audit_logs")
}

model BrokerageOffice {
  id                          String          @id @db.Uuid
  businessRegistrationNo      String          @unique @map("business_registration_no")
  brokerageRegistrationNo     String          @unique @map("brokerage_registration_no")
  name                        String
  representativeNameEncrypted String          @map("representative_name_encrypted")
  phoneCountryCode            String          @map("phone_country_code")
  phoneNumberEncrypted        String          @map("phone_number_encrypted")
  phoneHash                   String          @map("phone_hash")
  postalCode                  String          @map("postal_code")
  addressLine1                String          @map("address_line1")
  addressLine2                String?         @map("address_line2")
  status                      BrokerageStatus @default(PENDING)
  rejectionReason             String?         @map("rejection_reason")
  reviewedBy                  String?         @map("reviewed_by") @db.Uuid
  reviewedAt                  DateTime?       @map("reviewed_at") @db.Timestamptz(6)
  createdAt                   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  brokers                     BrokerProfile[]
  properties                  Property[]

  @@index([status, createdAt])
  @@map("brokerage_offices")
}

model BrokerProfile {
  userId             String          @id @map("user_id") @db.Uuid
  brokerageOfficeId  String          @map("brokerage_office_id") @db.Uuid
  licenseNumber      String          @unique @map("license_number")
  legalNameEncrypted String          @map("legal_name_encrypted")
  status             BrokerStatus    @default(PENDING)
  rejectionReason    String?         @map("rejection_reason")
  reviewedBy         String?         @map("reviewed_by") @db.Uuid
  reviewedAt         DateTime?       @map("reviewed_at") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  user               User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  brokerageOffice    BrokerageOffice @relation(fields: [brokerageOfficeId], references: [id], onDelete: Restrict)

  @@index([brokerageOfficeId, status])
  @@map("broker_profiles")
}

model Property {
  id                    String                         @id @db.Uuid
  listingNumber         String                         @unique @map("listing_number")
  brokerUserId          String                         @map("broker_user_id") @db.Uuid
  brokerageOfficeId     String?                        @map("brokerage_office_id") @db.Uuid
  listingType           PropertyListingType            @default(BROKERAGE) @map("listing_type")
  title                 String
  description           String
  propertyType          PropertyType                   @map("property_type")
  transactionType       PropertyTransactionType        @map("transaction_type")
  price                 Decimal                        @db.Decimal(18, 2)
  deposit               Decimal?                       @db.Decimal(18, 2)
  monthlyRent           Decimal?                       @map("monthly_rent") @db.Decimal(18, 2)
  currency              String                         @default("KRW")
  exclusiveArea         Decimal                        @map("exclusive_area") @db.Decimal(10, 2)
  supplyArea            Decimal?                       @map("supply_area") @db.Decimal(10, 2)
  rooms                 Int
  bathrooms             Int
  floor                 Int?
  totalFloors           Int?                           @map("total_floors")
  countryCode           String                         @default("KR") @map("country_code")
  region1               String
  region2               String?
  city                  String
  addressLine1          String                         @map("address_line1")
  addressLine2          String?                        @map("address_line2")
  latitude              Decimal?                       @db.Decimal(10, 7)
  longitude             Decimal?                       @db.Decimal(10, 7)
  status                PropertyStatus                 @default(DRAFT)
  rejectionReason       String?                        @map("rejection_reason")
  submittedAt           DateTime?                      @map("submitted_at") @db.Timestamptz(6)
  reviewedBy            String?                        @map("reviewed_by") @db.Uuid
  reviewedAt            DateTime?                      @map("reviewed_at") @db.Timestamptz(6)
  activatedAt           DateTime?                      @map("activated_at") @db.Timestamptz(6)
  createdAt             DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  registrant            User                           @relation("PropertyRegistrant", fields: [brokerUserId], references: [id], onDelete: Restrict)
  brokerageOffice       BrokerageOffice?               @relation(fields: [brokerageOfficeId], references: [id], onDelete: Restrict)
  reviewer              User?                          @relation("PropertyReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  ownershipVerification PropertyOwnershipVerification?
  media                 PropertyMedia[]
  mediaUploads          PropertyMediaUpload[]
  reports               PropertyReport[]
  visitReservations     VisitReservation[]
  chatRooms             PropertyChatRoom[]
  contracts             ElectronicContract[]

  @@index([status, createdAt])
  @@index([city, propertyType, transactionType, status])
  @@index([brokerUserId, status, updatedAt])
  @@index([brokerageOfficeId, status])
  @@map("properties")
}

model PropertyOwnershipVerification {
  id                         String                      @id @db.Uuid
  propertyId                 String                      @unique @map("property_id") @db.Uuid
  claimantUserId             String                      @map("claimant_user_id") @db.Uuid
  claimType                  OwnershipClaimType          @map("claim_type")
  evidenceReferenceEncrypted String                      @map("evidence_reference_encrypted")
  evidenceReferenceHash      String                      @map("evidence_reference_hash")
  status                     OwnershipVerificationStatus @default(PENDING)
  ownershipDeclarationAt     DateTime                    @map("ownership_declaration_at") @db.Timestamptz(6)
  noBrokerageDeclarationAt   DateTime                    @map("no_brokerage_declaration_at") @db.Timestamptz(6)
  rejectionReason            String?                     @map("rejection_reason")
  reviewedBy                 String?                     @map("reviewed_by") @db.Uuid
  reviewedAt                 DateTime?                   @map("reviewed_at") @db.Timestamptz(6)
  createdAt                  DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  property                   Property                    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  claimant                   User                        @relation("OwnershipClaimant", fields: [claimantUserId], references: [id], onDelete: Restrict)
  reviewer                   User?                       @relation("OwnershipReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([claimantUserId, status, createdAt])
  @@index([evidenceReferenceHash])
  @@map("property_ownership_verifications")
}

model PropertyMedia {
  id           String               @id @db.Uuid
  propertyId   String               @map("property_id") @db.Uuid
  type         PropertyMediaType
  url          String
  thumbnailUrl String?              @map("thumbnail_url")
  sortOrder    Int                  @default(0) @map("sort_order")
  isPublic     Boolean              @default(true) @map("is_public")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  property     Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  upload       PropertyMediaUpload?

  @@index([propertyId, type, isPublic, sortOrder])
  @@map("property_media")
}

model PropertyMediaUpload {
  id                  String            @id @db.Uuid
  propertyId          String            @map("property_id") @db.Uuid
  propertyMediaId     String?           @unique @map("property_media_id") @db.Uuid
  userId              String            @map("user_id") @db.Uuid
  mediaType           PropertyMediaType @map("media_type")
  originalFileName    String            @map("original_file_name")
  originalMimeType    String            @map("original_mime_type")
  originalSizeBytes   BigInt            @map("original_size_bytes")
  requestedIsPublic   Boolean           @default(true) @map("requested_is_public")
  requestedSortOrder  Int               @default(0) @map("requested_sort_order")
  status              MediaUploadStatus @default(REQUESTED)
  originalStorageKey  String?           @map("original_storage_key")
  storageKey          String?           @map("storage_key")
  thumbnailStorageKey String?           @map("thumbnail_storage_key")
  outputMimeType      String?           @map("output_mime_type")
  outputSizeBytes     BigInt?           @map("output_size_bytes")
  width               Int?
  height              Int?
  durationSeconds     Int?              @map("duration_seconds")
  attempts            Int               @default(0)
  errorCode           String?           @map("error_code")
  queuedAt            DateTime?         @map("queued_at") @db.Timestamptz(6)
  processingStartedAt DateTime?         @map("processing_started_at") @db.Timestamptz(6)
  completedAt         DateTime?         @map("completed_at") @db.Timestamptz(6)
  expiresAt           DateTime          @map("expires_at") @db.Timestamptz(6)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  property            Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyMedia       PropertyMedia?    @relation(fields: [propertyMediaId], references: [id], onDelete: SetNull)
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)

