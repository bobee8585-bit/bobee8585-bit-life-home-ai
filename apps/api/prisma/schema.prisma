model ElectronicContract {
  id                               String                      @id @db.Uuid
  contractNumber                   String                      @unique @map("contract_number") @db.VarChar(32)
  reservationId                    String                      @unique @map("reservation_id") @db.Uuid
  propertyId                       String                      @map("property_id") @db.Uuid
  memberUserId                     String                      @map("member_user_id") @db.Uuid
  registrantUserId                 String                      @map("registrant_user_id") @db.Uuid
  createdByUserId                  String                      @map("created_by_user_id") @db.Uuid
  provider                         ElectronicContractProvider
  providerContractId               String?                     @unique @map("provider_contract_id") @db.VarChar(200)
  status                           ElectronicContractStatus    @default(DRAFT)
  termsVersion                     String                      @map("terms_version") @db.VarChar(40)
  termsSnapshot                    Json                        @map("terms_snapshot")
  signedDocumentReferenceEncrypted String?                     @map("signed_document_reference_encrypted")
  signedDocumentReferenceHash      String?                     @map("signed_document_reference_hash") @db.VarChar(64)
  signedDocumentHash               String?                     @map("signed_document_hash") @db.VarChar(64)
  signingExpiresAt                 DateTime?                   @map("signing_expires_at") @db.Timestamptz(6)
  signedAt                         DateTime?                   @map("signed_at") @db.Timestamptz(6)
  retainedUntil                    DateTime                    @map("retained_until") @db.Timestamptz(6)
  failureCode                      String?                     @map("failure_code") @db.VarChar(80)
  createdAt                        DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                        DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  reservation                      VisitReservation            @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  property                         Property                    @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  member                           User                        @relation("ElectronicContractMember", fields: [memberUserId], references: [id], onDelete: Restrict)
  registrant                       User                        @relation("ElectronicContractRegistrant", fields: [registrantUserId], references: [id], onDelete: Restrict)
  creator                          User                        @relation("ElectronicContractCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  parties                          ElectronicContractParty[]
  histories                        ElectronicContractHistory[]
  webhookEvents                    ContractWebhookEvent[]

  @@index([memberUserId, status, createdAt])
  @@index([registrantUserId, status, createdAt])
  @@index([propertyId, status, createdAt])
  @@index([status, signingExpiresAt])
  @@index([retainedUntil])
  @@map("electronic_contracts")
}

