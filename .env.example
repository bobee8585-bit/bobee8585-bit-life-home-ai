NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://lifehome:lifehome_local@localhost:5432/lifehome?schema=public
REDIS_URL=redis://localhost:6379
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PII_ENCRYPTION_KEY=replace-with-a-long-random-secret
VERIFICATION_DELIVERY_MODE=log
MEDIA_STORAGE_MODE=local
MEDIA_STORAGE_ROOT=/tmp/lifehome-media
MEDIA_STAGING_ROOT=/tmp/lifehome-media-staging
MEDIA_WORK_ROOT=/tmp/lifehome-media-work
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=ap-northeast-2
MEDIA_S3_ENDPOINT=
MEDIA_S3_FORCE_PATH_STYLE=false
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_QUEUE_PREFIX=lifehome
MEDIA_WORKER_CONCURRENCY=2
MEDIA_WORKER_MAX_ATTEMPTS=4
MEDIA_WORKER_RETRY_BASE_MS=5000
EXCHANGE_RATE_PROVIDER=FRANKFURTER
EXCHANGE_RATE_PROVIDER_URL=https://api.frankfurter.dev/v2/rate/{base}/{quote}
EXCHANGE_RATE_FETCH_TIMEOUT_MS=5000
EXCHANGE_RATE_CACHE_TTL_SECONDS=900
EXCHANGE_RATE_STALE_TTL_SECONDS=604800
MAP_ROUTE_PROVIDER=disabled
GOOGLE_ROUTES_MATRIX_URL=https://routes.googleapis.com/distanceMatrix/v2:computeRouteMatrix
GOOGLE_ROUTES_API_KEY=
MAP_ROUTE_PROVIDER_TIMEOUT_MS=7000
PAYMENT_PROVIDER_MODE=mock
PAYMENT_PROVIDER_TIMEOUT_MS=7000
TOSS_PAYMENTS_API_BASE_URL=https://api.tosspayments.com/v1
TOSS_PAYMENTS_CLIENT_KEY=
TOSS_PAYMENTS_SECRET_KEY=
NICEPAY_API_BASE_URL=https://api.nicepay.co.kr/v1
NICEPAY_CLIENT_KEY=
NICEPAY_SECRET_KEY=
NHN_KCP_ENVIRONMENT=test
NHN_KCP_API_BASE_URL=https://stg-spl.kcp.co.kr
NHN_KCP_SITE_CODE=
NHN_KCP_CERTIFICATE_BASE64=
NHN_KCP_PRIVATE_KEY_BASE64=
NHN_KCP_PRIVATE_KEY_PASSPHRASE=
RESERVATION_DEPOSIT_AMOUNT_KRW=10000
RESERVATION_REFUND_POLICY_VERSION=2026-07-v2
RESERVATION_USER_CANCELLATION_REFUND_RATE=1.00
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_POLL_MS=5000
NOTIFICATION_WORKER_BATCH_SIZE=20
NOTIFICATION_WORKER_MAX_ATTEMPTS=6
NOTIFICATION_WORKER_LOCK_SECONDS=120
NOTIFICATION_WORKER_RETRY_BASE_SECONDS=30
NOTIFICATION_PROVIDER_TIMEOUT_MS=7000
PUSH_PROVIDER_MODE=log
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY_BASE64=
SMS_PROVIDER_MODE=log
NAVER_SENS_API_BASE_URL=https://sens.apigw.ntruss.com
NAVER_SENS_SERVICE_ID=
NAVER_CLOUD_ACCESS_KEY=
NAVER_CLOUD_SECRET_KEY=
NAVER_SENS_SMS_FROM=
CONTRACT_PROVIDER_MODE=mock
CONTRACT_ENABLED_PROVIDERS=MODOOSIGN,EFORM_SIGN,GOVERNMENT
